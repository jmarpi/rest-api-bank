# Variables de despliegue SOLO para desarrollo. No usar estos valores en producción.

# Token Bearer requerido en Authorization: Bearer <token> para /api/**
API_BEARER_TOKEN=36f2a3ed46a8ea0ccbff7af46de4533c8a11b9607812b07d

# API del Banco Mundial (configurable sin recompilar)
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
WORLD_BANK_TIMEOUT_SECONDS=10

# Base de datos PostgreSQL (compartidas por la app y el contenedor de BD)
POSTGRES_DB=countries
POSTGRES_USER=countries
POSTGRES_PASSWORD=countries
DB_HOST=postgres
DB_PORT=5432

# Puerto publicado de la aplicación
SERVER_PORT=8080
